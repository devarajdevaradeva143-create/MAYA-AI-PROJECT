# Maya AI — environment variables
#
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env` — it holds secrets.

# Gemini API key, used only by the separate `maya-cloud` command.
# Get one from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the model (settings.yaml cloud.model is the default).
# GEMINI_MODEL=gemini-2.5-flashAQ

# Optional self-hosted TURN for Internet P2P. Never commit real credentials.
# Enable in settings.yaml -> p2p.turn.enabled and set p2p.turn.host first.
# MAYA_TURN_USERNAME=
# MAYA_TURN_CREDENTIAL=